#!/bin/bash
# Webots can start this controller without inheriting a sourced ROS terminal.
set -e

CONTROLLER_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
ROS_SETUP="/opt/ros/${ROS_DISTRO:-humble}/setup.bash"
if [ -f "$ROS_SETUP" ]; then
    source "$ROS_SETUP"
fi

# Locate this workspace from either the source or installed controller path.
SEARCH_DIR="$CONTROLLER_DIR"
while [ "$SEARCH_DIR" != / ]; do
    if [ -f "$SEARCH_DIR/install/setup.bash" ]; then
        source "$SEARCH_DIR/install/setup.bash"
        break
    fi
    SEARCH_DIR="$(dirname "$SEARCH_DIR")"
done

# Webots normally supplies WEBOTS_HOME; retain the launch default for diagnostics.
export WEBOTS_HOME="${WEBOTS_HOME:-/usr/local/webots}"
CONTROLLER_PYTHON="$WEBOTS_HOME/lib/controller/python"
export PYTHONPATH="$CONTROLLER_PYTHON${PYTHONPATH:+:$PYTHONPATH}"

if [ "${1:-}" = --check-imports ]; then
    exec /usr/bin/python3 -c 'from controller import Supervisor; from bhv_simulator.bhv_sim import BhvIndependentSim; print("Controlador Webots e módulos ROS carregados com sucesso.")'
fi

exec /usr/bin/python3 -m bhv_simulator.bhv_sim "$@"
