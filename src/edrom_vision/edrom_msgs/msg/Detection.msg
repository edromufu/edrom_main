# Representa um único objeto detectado no frame da câmera

bool found          # True se o objeto foi encontrado
int32 x             # Coordenada X do centro do objeto no pixel
int32 y             # Coordenada Y do centro do objeto no pixel
int32 roi_width     # Largura da caixa de detecção (ROI)
int32 roi_height    # Altura da caixa de detecção (ROI)
