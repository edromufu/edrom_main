import cv2
import os

# ==============================================================================
# --- CONFIGURAÇÕES ---
# ==============================================================================
CAMERA_INDEX = 2             # Mude este número se você tiver múltiplas câmeras (0, 1, 2...)
OUTPUT_FILENAME = "calibration_image.png"
# ==============================================================================


def main():
    print("--- Capturador de Frame para Calibracao IPM ---")
    
    # Inicializa a câmera
    cap = cv2.VideoCapture(CAMERA_INDEX)
    
    if not cap.isOpened():
        print(f"ERRO: Nao foi possivel abrir a camera no indice {CAMERA_INDEX}.")
        print("Verifique se a camera esta conectada corretamente e se o indice esta certo.")
        return

    print("\nJanela da camera aberta.")
    print("Posicione o robo e o retangulo de calibracao.")
    print("\nPressione a tecla 'ESPACO' para capturar e salvar a imagem.")
    print("Pressione a tecla 'q' para sair sem salvar.")

    while True:
        # Lê um frame da câmera
        ret, frame = cap.read()
        if not ret:
            print("Nao foi possivel ler o frame da camera. Encerrando.")
            break

        # Mostra o frame ao vivo
        cv2.imshow("Camera Ao Vivo - Pressione ESPACO para Capturar", frame)

        # Aguarda por uma tecla
        key = cv2.waitKey(1) & 0xFF

        if key == ord('q'):
            print("Saida solicitada. Nenhum frame foi salvo.")
            break
        
        elif key == ord(' '): # Tecla de espaço
            # Salva o frame atual no arquivo de saída
            cv2.imwrite(OUTPUT_FILENAME, frame)
            
            # Mostra uma mensagem de sucesso na imagem salva
            success_text = "Imagem Salva!"
            text_size = cv2.getTextSize(success_text, cv2.FONT_HERSHEY_SIMPLEX, 2, 3)[0]
            text_x = (frame.shape[1] - text_size[0]) // 2
            text_y = (frame.shape[0] + text_size[1]) // 2
            
            cv2.putText(frame, success_text, (text_x, text_y), cv2.FONT_HERSHEY_SIMPLEX, 2, (0, 255, 0), 3)
            cv2.imshow("Camera Ao Vivo - Pressione ESPACO para Capturar", frame)
            cv2.waitKey(1000) # Mostra a mensagem por 1 segundo

            print(f"\nIMAGEM SALVA COM SUCESSO como '{os.path.abspath(OUTPUT_FILENAME)}'")
            break

    # Libera os recursos
    cap.release()
    cv2.destroyAllWindows()
    print("Programa encerrado.")

if __name__ == '__main__':
    main()
